# Public hostname that already points at this VPS. Caddy requests a certificate for it.
DOMAIN=hotelpulse.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=hotelpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hotelpulse

# Letters and digits. The value is placed into an AMQP URI.
RABBITMQ_USER=hotelpulse
RABBITMQ_PASSWORD=change-me

# Optional. Leave unset to keep the 700/800/900 ms pipeline and a 90% confirm rate.
# HOTELPULSE_STEP_DELAY_MS=0
# HOTELPULSE_CONFIRM_PROBABILITY=0.9
