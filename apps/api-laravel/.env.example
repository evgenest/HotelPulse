# HotelPulse Laravel API. Copy to .env for local runs; production sets real env vars.
APP_NAME=HotelPulse
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081

# Connection URLs, same names the .NET services read (first one found wins).
DATABASE_URL=postgres://hotelpulse:hotelpulse@localhost:5433/hotelpulse_laravel
# Direct (non-pooled) URL for migrations; defaults to DATABASE_URL.
DATABASE_URL_UNPOOLED=
REDIS_URL=redis://localhost:6379/1
AMQP_URL=amqp://hotelpulse:hotelpulse@localhost:5672/

# Kept apart from the .NET stack so the two never consume each other's data.
HOTELPULSE_EXCHANGE=hotelpulse.laravel
HOTELPULSE_QUEUE=bookings.created.laravel
HOTELPULSE_REDIS_PREFIX=laravel:

# Worker tuning, same meaning as in the .NET worker.
HOTELPULSE_STEP_DELAY_MS=
HOTELPULSE_CONFIRM_PROBABILITY=

CORS_ORIGINS=http://localhost:3000

LOG_CHANNEL=stderr_json
LOG_LEVEL=info

# The API has no sessions, views or Laravel queues.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
